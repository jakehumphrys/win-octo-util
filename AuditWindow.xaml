<Window x:Class="UsageWidget.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Log" Width="760" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" MouseLeftButtonDown="Drag">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A79BC9"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#4A3A78" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One log entry -->
        <DataTemplate x:Key="EntryTemplate">
            <Border Background="#22FFFFFF" CornerRadius="8" Padding="12,9" Margin="0,0,10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding Accent}" CornerRadius="4" Padding="6,1"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#140D2B"/>
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Muted}"
                             FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border Margin="12" Padding="18,16" CornerRadius="14"
            BorderBrush="#4A3A78" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B2475" Offset="0"/>
                <GradientStop Color="#231642" Offset="0.55"/>
                <GradientStop Color="#140D2B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top">
                <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SmallLabel}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostBtn}" Content="Copy all" Click="CopyAll"/>
                    <Button Style="{StaticResource GhostBtn}" Content="Clear" Click="Clear"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="✕" Click="CloseClick"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource EntryTemplate}"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
