<Window x:Class="UsageWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" MouseLeftButtonDown="Drag">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A79BC9"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4A3A78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8A6FD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3DDC84"/>
            <Setter Property="Foreground" Value="#140D2B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#57E89B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#4A3A78" BorderThickness="1" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border Margin="12" Padding="18,16" CornerRadius="14"
            BorderBrush="#4A3A78" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B2475" Offset="0"/>
                <GradientStop Color="#231642" Offset="0.55"/>
                <GradientStop Color="#140D2B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="SETTINGS" Style="{StaticResource SmallLabel}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Style="{StaticResource HeaderBtn}" Content="✕" HorizontalAlignment="Right"
                        Click="CloseClick" ToolTip="Close"/>
            </Grid>

            <TextBlock Text="OCTOPUS API KEY" Style="{StaticResource SmallLabel}"
                       FontWeight="SemiBold" Margin="0,16,0,0"/>
            <TextBox x:Name="ApiKeyBox" Style="{StaticResource Field}" FontFamily="Consolas"/>

            <TextBlock Text="ACCOUNT NUMBER" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
            <TextBox x:Name="AccountBox" Style="{StaticResource Field}"/>

            <TextBlock Text="ELECTRICITY MPAN" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
            <TextBox x:Name="ElectricMpanBox" Style="{StaticResource Field}"/>

            <TextBlock Text="ELECTRICITY METER SERIAL" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
            <TextBox x:Name="ElectricSerialBox" Style="{StaticResource Field}"/>

            <TextBlock Text="GAS METER MPAN" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
            <TextBox x:Name="GasMpanBox" Style="{StaticResource Field}"/>

            <TextBlock Text="GAS METER SERIAL" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
            <TextBox x:Name="GasSerialBox" Style="{StaticResource Field}"/>

            <CheckBox x:Name="GasCubicMetresBox" Foreground="{StaticResource Text}" FontSize="12"
                      Content="Gas readings are in m³ (SMETS2 meter)" Margin="0,0,0,12"/>

            <TextBlock Text="DAILY GOALS (kWh)" Style="{StaticResource SmallLabel}"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Electricity" Style="{StaticResource SmallLabel}"/>
                    <TextBox x:Name="ElectricGoalBox" Style="{StaticResource Field}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Gas" Style="{StaticResource SmallLabel}"/>
                    <TextBox x:Name="GasGoalBox" Style="{StaticResource Field}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Status" Foreground="{StaticResource Text}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource GhostBtn}" Content="Close" Click="CloseClick"/>
                <Button Style="{StaticResource PrimaryBtn}" Content="Save" Click="Save"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
