<Window x:Class="UsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        FontFamily="Segoe UI" MouseLeftButtonDown="Drag">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A79BC9"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Track" Color="#4A3A78"/>
        <SolidColorBrush x:Key="Warn" Color="#F2C94C"/>

        <!-- Fuel colours: anything electric is yellow, anything gas is blue. -->
        <SolidColorBrush x:Key="Electric" Color="#FFD24A"/>
        <SolidColorBrush x:Key="Gas" Color="#4DA3FF"/>

        <!-- Rounded progress bar. Height sets thickness, Foreground sets fill colour -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource Track}"
                                    CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border Margin="12" Padding="18,16" CornerRadius="14"
            BorderBrush="#4A3A78" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B2475" Offset="0"/>
                <GradientStop Color="#231642" Offset="0.55"/>
                <GradientStop Color="#140D2B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="WIN OCTO UTILS" Style="{StaticResource SmallLabel}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="🐙" Foreground="#FF7A59" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource HeaderBtn}" Content="⟳"
                            Click="Refresh" ToolTip="Refresh"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="£" Click="OpenTariff"
                            ToolTip="Tariff &amp; estimated cost"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="⚙" Click="OpenSettings"
                            ToolTip="Settings"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="☰" Click="OpenAudit"
                            ToolTip="Activity log"/>
                    <Button x:Name="CollapseToggle" Style="{StaticResource HeaderBtn}" Content="▾"
                            Click="ToggleDetails" ToolTip="Collapse"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="–" Click="Minimise"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="✕" Click="CloseClick"
                            ToolTip="Hide to tray"/>
                </StackPanel>
            </Grid>

            <!-- Day navigation (always visible - the overview below follows the selected day) -->
            <StackPanel Margin="0,14,0,0">
                <Grid>
                    <Button x:Name="PrevDayButton" Style="{StaticResource HeaderBtn}" Content="‹"
                            FontSize="16" HorizontalAlignment="Left" Click="PreviousDay"
                            ToolTip="Previous day"/>
                    <TextBlock x:Name="DayLabel" Text="Today" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextDayButton" Style="{StaticResource HeaderBtn}" Content="›"
                            FontSize="16" HorizontalAlignment="Right" Click="NextDay"
                            ToolTip="Next day"/>
                </Grid>
                <TextBlock x:Name="TodayHint" Text="today's readings may still be arriving"
                           Foreground="{StaticResource Warn}" FontSize="10" HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="CacheBadge" Text="⇓ from cache" Visibility="Collapsed"
                           Foreground="#8AB4F8" FontSize="10" HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           ToolTip="Loaded from the local cache — no API request was made"/>
            </StackPanel>

            <!-- Usage Overview -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ELECTRICITY" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock x:Name="ElectricValue" Text="—" FontFamily="Segoe UI Light"
                                   FontSize="44" Foreground="{StaticResource Electric}"/>
                        <TextBlock Text="kWh" FontSize="15" Foreground="{StaticResource Electric}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <ProgressBar x:Name="ElectricBar" Foreground="{StaticResource Electric}"/>
                    <TextBlock x:Name="ElectricCost" Text="≈ £—" Foreground="{StaticResource Electric}"
                               FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="GAS" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock x:Name="GasValue" Text="—" FontFamily="Segoe UI Light"
                                   FontSize="44" Foreground="{StaticResource Gas}"/>
                        <TextBlock Text="kWh" FontSize="15" Foreground="{StaticResource Gas}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <ProgressBar x:Name="GasBar" Foreground="{StaticResource Gas}"/>
                    <TextBlock x:Name="GasCost" Text="≈ £—" Foreground="{StaticResource Gas}"
                               FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Estimated cost for the selected day (always visible) -->
            <TextBlock x:Name="TotalCost" Text="" Foreground="{StaticResource Muted}"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>

            <!-- Collapsible detail (hidden when the header arrow is toggled) -->
            <StackPanel x:Name="Details">
                <TextBlock x:Name="ReadingInfo" Text="today so far · not yet loaded" Margin="0,10,0,16"
                           Foreground="{StaticResource Text}" FontSize="13"/>

                <!-- Secondary rows -->
                <!-- Electricity for the selected day -->
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="ElectricChartLabel" Text="ELECTRICITY · TODAY"
                               Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ElectricRangeLabel" Text="00:00 → now"
                               Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl x:Name="ElectricChart" Height="40" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" Margin="0.5,0"
                                        CornerRadius="2,2,0,0" Background="{StaticResource Electric}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Gas for the selected day -->
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="GasChartLabel" Text="GAS · TODAY"
                               Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GasRangeLabel" Text="00:00 → now"
                               Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl x:Name="GasChart" Height="40" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" Margin="0.5,0"
                                        CornerRadius="2,2,0,0" Background="{StaticResource Gas}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Status -->
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#3DDC84"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Not yet loaded" Foreground="{StaticResource Text}"
                               FontSize="13"/>
                </StackPanel>

                <TextBlock x:Name="Stamp" Text="19:54:26" FontSize="10" Foreground="#5A6066"
                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
