<Window x:Class="UsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Widget" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        FontFamily="Segoe UI" MouseLeftButtonDown="Drag">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A79BC9"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Track" Color="#4A3A78"/>

        <!-- Rounded progress bar. Height sets thickness, Foreground sets fill colour -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource Track}"
                                    CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border Margin="12" Padding="18,16" CornerRadius="14"
            BorderBrush="#4A3A78" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B2475" Offset="0"/>
                <GradientStop Color="#231642" Offset="0.55"/>
                <GradientStop Color="#140D2B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="WIN OCTO UTILS" Style="{StaticResource SmallLabel}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="🐙" Foreground="#FF7A59" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="▾"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="–" Click="Minimise"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="✕" Click="Close"/>
                </StackPanel>
            </Grid>

            <!-- Usage Overview -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ELECTRICITY" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Text="7.4" FontFamily="Segoe UI Light" FontSize="44" Foreground="#3DDC84"/>
                        <TextBlock Text="kWh" FontSize="15" Foreground="#3DDC84"
                                   VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <ProgressBar Value="50" Foreground="#3DDC84"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="GAS" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Text="12.1" FontFamily="Segoe UI Light" FontSize="44" Foreground="#3DDC84"/>
                        <TextBlock Text="kWh" FontSize="15" Foreground="#3DDC84"
                                   VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <ProgressBar Value="40" Foreground="#3DDC84"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="today so far · last reading 19:30" Margin="0,10,0,16"
                       Foreground="{StaticResource Text}" FontSize="13"/>

            <!-- Secondary rows -->
            <!-- Electricity today -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="ELECTRICITY · TODAY" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                <TextBlock Text="00:00 → now" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/>
            </Grid>
            <ItemsControl Height="40" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0"
                                CornerRadius="2,2,0,0" Background="#3DDC84"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsSource>
                    <x:Array Type="sys:Double">
                        <sys:Double>6</sys:Double><sys:Double>5</sys:Double><sys:Double>5</sys:Double>
                        <sys:Double>5</sys:Double><sys:Double>6</sys:Double><sys:Double>9</sys:Double>
                        <sys:Double>22</sys:Double><sys:Double>30</sys:Double><sys:Double>18</sys:Double>
                        <sys:Double>10</sys:Double><sys:Double>8</sys:Double><sys:Double>9</sys:Double>
                        <sys:Double>12</sys:Double><sys:Double>10</sys:Double><sys:Double>8</sys:Double>
                        <sys:Double>11</sys:Double><sys:Double>20</sys:Double><sys:Double>34</sys:Double>
                        <sys:Double>38</sys:Double><sys:Double>28</sys:Double>
                    </x:Array>
                </ItemsControl.ItemsSource>
            </ItemsControl>

            <!-- Gas today -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="GAS · TODAY" Style="{StaticResource SmallLabel}" FontWeight="SemiBold"/>
                <TextBlock Text="00:00 → now" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/>
            </Grid>
            <ItemsControl Height="40" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0"
                                CornerRadius="2,2,0,0" Background="#F2994A"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsSource>
                    <x:Array Type="sys:Double">
                        <sys:Double>2</sys:Double><sys:Double>2</sys:Double><sys:Double>2</sys:Double>
                        <sys:Double>2</sys:Double><sys:Double>3</sys:Double><sys:Double>14</sys:Double>
                        <sys:Double>36</sys:Double><sys:Double>30</sys:Double><sys:Double>10</sys:Double>
                        <sys:Double>6</sys:Double><sys:Double>5</sys:Double><sys:Double>4</sys:Double>
                        <sys:Double>6</sys:Double><sys:Double>5</sys:Double><sys:Double>4</sys:Double>
                        <sys:Double>5</sys:Double><sys:Double>12</sys:Double><sys:Double>24</sys:Double>
                        <sys:Double>32</sys:Double><sys:Double>20</sys:Double>
                    </x:Array>
                </ItemsControl.ItemsSource>
            </ItemsControl>

            <!-- Status -->
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#3DDC84" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="All systems operational" Foreground="{StaticResource Text}" FontSize="13"/>
            </StackPanel>

            <TextBlock x:Name="Stamp" Text="19:54:26" FontSize="10" Foreground="#5A6066"
                       HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
