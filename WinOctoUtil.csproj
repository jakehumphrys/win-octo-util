<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Windows Forms is only used for the notification-area (tray) icon. -->
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Assets\octopus.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Keep the WinForms implicit usings out so they cannot clash with the WPF types
         (Application, Brush, ...). WinForms types are referenced fully-qualified instead. -->
    <ItemGroup>
        <Using Remove="System.Drawing" />
        <Using Remove="System.Windows.Forms" />
    </ItemGroup>

</Project>
